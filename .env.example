# --- Application ---
NODE_ENV=development
APP_NAME=SaaSForge
API_PORT=3000
WEB_PORT=5173
WORKER_HEALTH_PORT=3001
WEB_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_USER=saasforge
POSTGRES_PASSWORD=saasforge
POSTGRES_DB=saasforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://saasforge:saasforge@localhost:5432/saasforge?schema=public

# Used by integration tests (created automatically if missing)
TEST_DATABASE_URL=postgresql://saasforge:saasforge@localhost:5432/saasforge_test?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_ACCESS_EXPIRES_IN=900
REFRESH_TOKEN_TTL_SECONDS=1209600
JWT_REFRESH_EXPIRES_IN=1209600
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# HMAC pepper for API keys (not the key itself)
API_KEY_PEPPER=replace-with-a-long-random-api-key-pepper

# --- Rate limiting (API-key surface) ---
API_KEY_RATE_LIMIT=60
API_KEY_RATE_WINDOW_SEC=60
JWT_IP_RATE_LIMIT=120
JWT_IP_RATE_WINDOW_SEC=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SEC=900

# --- Invitations ---
INVITATION_TTL_HOURS=72
APP_PUBLIC_URL=http://localhost:5173

# --- Email ---
# development = log to stdout; ses/resend can be added later
EMAIL_DRIVER=development
EMAIL_PROVIDER=development
EMAIL_FROM=noreply@saasforge.local
